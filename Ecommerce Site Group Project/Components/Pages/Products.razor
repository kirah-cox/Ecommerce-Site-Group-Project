@page "/products"

@inject NavigationManager NavManager

<div class="page-header">
    <h1>All Products</h1>
</div>

<div class="product-grid">

    @if(products != null)
    {
        @foreach (var product in products)
         {
            <div class="product-card">
                <div class="image-container">
                    <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                </div>
                <div class="product-info">
                    <h3 class="product-name">@product.Name</h3>
                    <p class="product-price">@product.Price.ToString("C")</p>
                    <button class="view-details-btn" @onclick="GoToProduct">View Product</button>
                </div>
            </div>
      }
    }
    
</div>

@code {
    private List<Product>? products = new List<Product> { new Product("NAME", 5.00, "image"), new Product("product 2", 7.00, "image") };



    public class Product
    {
        public string Name { get; set; } = "";
        public double Price { get; set; }
        public string ImageUrl { get; set; } = "";

        public Product (String name, Double price, String image)
        {
            Name = name;
            Price = price;
            ImageUrl = image;
        }
    }

    public void GoToProduct()
    {
        NavManager.NavigateTo("/product");
    }
}