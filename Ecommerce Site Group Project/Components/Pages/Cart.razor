@page "/cart"
@rendermode InteractiveServer
@using Ecommerce_Site_Group_Project.Components
@inject ActiveOrders ShopingCart

<PageTitle>Home</PageTitle>


<div class="home-container">
    <h1>Shopping Cart</h1>
    
    <div style="margin: 0; padding: 0; width: 100%;">
        <table style="margin-left: auto; margin-right: auto;">
        @foreach (var item in ShopingCart.Order)
        {
            <tr>
                <td style="white-space: nowrap; min-width: 25vh;">@item.Name</td>
                <td style="white-space: nowrap; min-width: 25vh;">@item.Price</td>
                <td style="white-space: nowrap; min-width: 25vh;"></td>
            </tr>
        }
        <tr>
            <td style="white-space: nowrap; min-width: 25vh;">Subtotal: @ShopingCart.GetPriceTotal().ToString("C2")</td>
            <td style="white-space: nowrap; min-width: 25vh;">Total: @ShopingCart.PriceTotal.ToString("C2")</td>
            <td style="white-space: nowrap; min-width: 25vh;">Tax: @((ShopingCart.GetPriceTotal() - ShopingCart.PriceTotal).ToString("C2"))</td>
        </tr>
        </table>

        
    </div>
</div>
<Footer />

