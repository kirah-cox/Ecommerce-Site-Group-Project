@page "/"
@rendermode InteractiveServer
@using Ecommerce_Site_Group_Project.Components

<PageTitle>Home</PageTitle>


<div class="home-container">
    <h1>Featured Products</h1>
    
    <div>
        <form>
            <div class="filter-buttons-main-display">
                <input type="button" @onclick="SortProductsByPrice" class="filter-buttons" value="Sort By Price">

                <input type="button" @onclick="SortProductsByName" class="filter-buttons" value="Sort By Name">

                <input type="button" @onclick="SortProductsByMaxPrice" class="filter-buttons" value="Sort By Max Price">

                <input type="button" @onclick="SortProductsByPriceRange" class="filter-buttons" value="Sort By Price Range">

                <input type="submit" class="filter-buttons" value="Reset Filtering">
            </div>

            @if (SortingByMaxPrice)
            {
                <div class="radio-sorting-container">
                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 10)" type="radio" name="price">
                        <label> Up to $10</label><br>
                    </div>

                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 20)" type="radio" name="price">
                        <label> Up to $20</label><br>
                    </div>

                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 30)" type="radio" name="price">
                        <label> Up to $30</label><br>
                    </div>

                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 40)" type="radio" name="price">
                        <label> Up to $40</label><br>
                    </div>

                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 50)" type="radio" name="price">
                        <label> Up to $50</label><br>
                    </div>

                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 60)" type="radio" name="price">
                        <label> Up to $60</label><br>
                    </div>

                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 70)" type="radio" name="price">
                        <label> Up to $70</label><br>
                    </div>

                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 80)" type="radio" name="price">
                        <label> Up to $80</label><br>
                    </div>
                </div>
            }

            @if (SortingByPriceRange)
            {
                <div class="radio-sorting-container">
                    <div>
                        <input @onclick="() => FilterProductsByPrice(0, 10)" type="radio" name="price">
                        <label> $0 to $10</label><br>
                    </div>
                    
                    <div>
                        <input @onclick="() => FilterProductsByPrice(10, 20)" type="radio" name="price">
                        <label> $10 to $20</label><br>
                    </div>
                    
                    <div>
                        <input @onclick="() => FilterProductsByPrice(20, 30)" type="radio" name="price">
                        <label> $20 to $30</label><br>
                    </div>
                    
                    <div>
                        <input @onclick="() => FilterProductsByPrice(30, 40)" type="radio" name="price">
                        <label> $30 to $40</label><br>
                    </div>
                    
                    <div>
                        <input @onclick="() => FilterProductsByPrice(40, 50)" type="radio" name="price">
                        <label> $40 to $50</label><br>
                    </div>
                    
                    <div>
                        <input @onclick="() => FilterProductsByPrice(50, 60)" type="radio" name="price">
                        <label> $50 to $60</label><br>
                    </div>
                    
                    <div>
                        <input @onclick="() => FilterProductsByPrice(60, 70)" type="radio" name="price">
                        <label> $60 to $70</label><br>
                    </div>
                    
                    <div>
                        <input @onclick="() => FilterProductsByPrice(70, 80)" type="radio" name="price">
                        <label> $70 to $80</label><br>
                    </div>
                </div>
            }
        </form>
    </div>
    
    @if (products == null)
    {
        <p>Loading products...</p>
    }
    else if (products.Count == 0)
    {
        <div class="no-products">
            <p>No products available yet.</p>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var product in products)
            {
                <ProductCard Product="product" />
            }
        </div>
    }
</div>

<Footer />

@code {
    private List<Product>? products;
    private List<Product>? OriginalProductList;
    private bool SortedByPriceAscending = false;
    private bool SortedByNameAscending = false;
    private bool SortingByMaxPrice = false;
    private bool SortingByPriceRange = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await Product.ProductCollection.LoadAsync();
            OriginalProductList = await Product.ProductCollection.LoadAsync();

            // If no products exist, create sample products for MVP
            if (products.Count == 0)
            {
                var sampleProducts = new List<Product>
                {
                    new Product { Name = "Wireless Headphones", Price = 79.99m, Description = "High-quality wireless headphones with noise cancellation" },
                    new Product { Name = "USB-C Cable", Price = 12.99m, Description = "Durable 6ft USB-C charging and data cable" },
                    new Product { Name = "Phone Stand", Price = 24.99m, Description = "Adjustable phone stand for desk and travel" },
                    new Product { Name = "Power Bank", Price = 39.99m, Description = "20000mAh portable power bank with fast charging" },
                    new Product { Name = "Screen Protector", Price = 9.99m, Description = "Tempered glass screen protector for smartphones" },
                    new Product { Name = "Laptop Cooling Pad", Price = 34.99m, Description = "Laptop cooling pad with adjustable fan speed" }
                };

                foreach (var product in sampleProducts)
                {
                    await product.Add();
                }

                products = sampleProducts;
                OriginalProductList = sampleProducts;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
            products = new List<Product>();
        }
    }

    void SortProductsByPrice()
    {
        if (products != null)
        {
            if (SortedByPriceAscending)
            {
                products = products.OrderByDescending(p => p.Price).ToList();
                SortedByPriceAscending = false;
            }
            else
            {
                products = products.OrderBy(p => p.Price).ToList();
                SortedByPriceAscending = true;
            }
        }
    }

    void SortProductsByName()
    {
        if (products != null)
        {
            if (SortedByNameAscending)
            {
                products = products.OrderByDescending(p => p.Name).ToList();
                SortedByNameAscending = false;
            }
            else
            {
                products = products.OrderBy(p => p.Name).ToList();
                SortedByNameAscending = true;
            }
        }
    }

    void FilterProductsByPrice(decimal minPrice, decimal maxPrice)
    {
        products = OriginalProductList;

        if (products != null)
        {
            products = products.Where(p => p.Price >= minPrice && p.Price <= maxPrice).ToList();
        }
    }

    void SortProductsByMaxPrice()
    {
        if (SortingByMaxPrice)
        {
            SortingByMaxPrice = false;
        }
        else
        {
            SortingByMaxPrice = true;
        }

        SortingByPriceRange = false;
    }

     void SortProductsByPriceRange()
    {
        if (SortingByPriceRange)
        {
            SortingByPriceRange = false;
        }
        else
        {
            SortingByPriceRange = true;
        }

        SortingByMaxPrice = false;
    }
}