@using System

<div class="product-card">
    <div class="product-name-bar">
        <h3 class="product-name">@Product.Name</h3>
    </div>
    <div class="product-image">
        <img src="#" alt="" />
    </div>
    <div class="product-info">
        <p class="product-description">@Product.Description</p>
        <div class="product-rating">
            <span class="stars">★★★★☆</span>
            <span class="rating-count">(245 reviews)</span>
        </div>
        <div class="product-footer">
            <span class="product-price">$@Product.Price.ToString("F2")</span>
            <button class="add-to-cart-btn">Add to Cart</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product? Product { get; set; }


    public void GoToProductPage()
    {
        if (Product?.Id != default(Guid))
        {
            string URL = $"/product/{Product.Id}";
            NavManager.NavigateTo(URL, true);
        }
    }
}
